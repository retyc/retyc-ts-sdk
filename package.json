{
  "name": "@retyc/sdk",
  "version": "1.1.0-beta1",
  "description": "TypeScript SDK for the Retyc API — OIDC auth + E2E encrypted transfers",
  "keywords": [
    "retyc",
    "file-transfer",
    "file-sharing",
    "e2ee",
    "end-to-end-encryption",
    "age",
    "post-quantum",
    "sdk"
  ],
  "license": "MIT",
  "homepage": "https://github.com/retyc/retyc-ts-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retyc/retyc-ts-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/retyc/retyc-ts-sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc --project tsconfig.build.json --emitDeclarationOnly --declarationMap",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "age-encryption": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
